# /var/www/sarah/.env.local — JAMAIS dans git (chmod 600, propriétaire sarah)
# Après chaque modification : composer dump-env prod (génère .env.local.php, lu plus vite)

APP_ENV=prod
APP_DEBUG=0
# Générer avec : php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=À_GÉNÉRER

DEFAULT_URI=https://sarah.famille-pitz.net

DATABASE_URL="mysql://sarah_user:MOT_DE_PASSE_FORT@127.0.0.1:3306/sarah_db?serverVersion=11.4.10-MariaDB&charset=utf8mb4"

# Serveur SMTP réel (invitations et mots de passe oubliés)
MAILER_DSN=smtp://UTILISATEUR:MOT_DE_PASSE@smtp.example.net:587
MAILER_FROM="Site de Sarah <noreply@sarah.famille-pitz.net>"

# Médias envoyés par nginx (location /_media_internal/ de nginx-sarah.conf).
# CyberPanel / OpenLiteSpeed : laisser VIDE (PHP envoie lui-même les fichiers)
MEDIA_X_ACCEL_PREFIX=/_media_internal
