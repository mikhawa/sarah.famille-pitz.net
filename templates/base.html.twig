<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>{% block title %}Sarah{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🌈</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% if app.user %}
            {% set route = app.request.attributes.get('_route') %}
            <header class="site-header">
                <a href="{{ path('app_home') }}" class="site-title">🌈 Sarah</a>
                <nav class="site-nav" aria-label="Navigation principale">
                    <a href="{{ path('app_home') }}" {% if route == 'app_home' %}aria-current="page"{% endif %}>Tout voir</a>
                    <a href="{{ path('album_index') }}" {% if route starts with 'album_' or route starts with 'tag_' %}aria-current="page"{% endif %}>Albums</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin') }}" data-turbo="false">Administration</a>
                    {% endif %}
                </nav>
                <div class="site-user">
                    <span>Bonjour {{ app.user.displayName }}</span>
                    <a href="{{ path('app_logout') }}" data-turbo="false">Se déconnecter</a>
                </div>
            </header>
        {% endif %}

        <main>
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
