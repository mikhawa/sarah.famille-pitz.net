{% extends 'base.html.twig' %}

{% block title %}{{ tag.name }} — Sarah{% endblock %}

{% block body %}
    <p class="breadcrumb"><a href="{{ path('album_index') }}">‹ Albums et thèmes</a></p>

    <header class="page-header">
        <h1>{{ tag.name }}</h1>
        <p class="meta">{{ medias.totalItems }} {{ medias.totalItems > 1 ? 'souvenirs' : 'souvenir' }}</p>
    </header>

    {% if medias.items is empty %}
        <p class="empty">Aucun souvenir avec ce thème pour l'instant.</p>
    {% else %}
        <ul class="grid">
            {% for media in medias.items %}
                {{ include('media/_tile.html.twig') }}
            {% endfor %}
        </ul>
        {{ include('_pagination.html.twig', {route: 'tag_show', params: {slug: tag.slug}}) }}
    {% endif %}
{% endblock %}
