{#- Attributs PhotoSwipe d'un lien vers une photo : image affichée et ses dimensions (rien si elles sont inconnues).
    Image choisie par la fonction Twig lightbox_image() (GIF : l'original, pour garder l'animation).
    data-lightbox-id relie la vignette à sa place dans la liste complète d'un album (data-lightbox-items-value). -#}
{%- set lightbox_data = lightbox_image(media) -%}
{%- if lightbox_data %} data-pswp-src="{{ lightbox_data.src }}" data-pswp-width="{{ lightbox_data.width }}" data-pswp-height="{{ lightbox_data.height }}" data-comments-url="{{ path('media_comments', {id: media.id}) }}" data-lightbox-id="{{ media.id }}"{% endif -%}
